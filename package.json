{
  "name": "infinity-scanner",
  "version": "1.0.0",
  "description": "A modern mobile document scanner app built with React Native and Expo",
  "main": "expo-router/build/index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "dependencies": {
    "expo": "^51.0.0",
    "expo-camera": "^14.1.0",
    "expo-document-picker": "^11.5.0",
    "expo-file-system": "^17.0.0",
    "expo-image-manipulator": "^11.5.0",
    "expo-linear-gradient": "^12.8.0",
    "expo-media-library": "^14.3.0",
    "expo-permissions": "^14.4.0",
    "expo-router": "^3.4.0",
    "expo-sharing": "^12.4.0",
    "expo-splash-screen": "^0.28.0",
    "expo-status-bar": "^1.12.0",
    "react": "^18.2.0",
    "react-native": "^0.74.0",
    "react-native-gesture-handler": "^2.15.0",
    "react-native-reanimated": "^3.11.0",
    "react-native-screens": "^3.31.0",
    "react-native-svg": "^15.2.0",
    "zustand": "^4.4.0",
    "@react-native-async-storage/async-storage": "^1.23.0",
    "react-native-pdf": "^6.7.0",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.74.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^8.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^51.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true
}
