{
  "name": "infinity-scanner",
  "version": "1.0.0",
  "description": "Infinity Scanner - mobile document scanner app built with React Native and Expo",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --watch=false",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.0",
    "expo": "~51.0.0",
    "expo-camera": "~14.1.0",
    "expo-document-picker": "~11.5.0",
    "expo-file-system": "~17.0.0",
    "expo-image-manipulator": "~12.0.0",
    "expo-linear-gradient": "~12.8.0",
    "expo-media-library": "~16.0.0",
    "expo-print": "~12.0.0",
    "expo-sharing": "~12.0.0",
    "expo-status-bar": "~1.12.0",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "zustand": "^4.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^51.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
